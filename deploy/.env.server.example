# Copy this file to deploy/.env.server on the server.  It is ignored by Git.
# The CPU profile works with this file unchanged; cloud tools remain disabled.

PDF_BENCHMARK_WEB_MAX_UPLOAD_BYTES=104857600
PDF_BENCHMARK_WEB_MAX_PAGES=300
PDF_BENCHMARK_WEB_DOCUMENT_TTL_SECONDS=86400
PDF_BENCHMARK_WEB_CLEANUP_INTERVAL_SECONDS=900
PDF_BENCHMARK_WEB_EXECUTOR_WORKERS=2
PDF_BENCHMARK_WEB_ADAPTER_TIMEOUT_SECONDS=5400
PDF_BENCHMARK_WEB_LOG_LEVEL=INFO
PDF_BENCHMARK_WEB_DOCS_ENABLED=false
PDF_BENCHMARK_WEB_ALLOW_CLOUD=false

# Set true only after adding the required provider variables below.
# PDF_BENCHMARK_WEB_ALLOW_CLOUD=true
# OCR_SPACE_API_KEY=
# NUTRIENT_DWS_EXTRACTION_API_KEY=
# MINDEE_V2_API_KEY=
# MINDEE_OCR_MODEL_ID=
# PDF_SERVICES_CLIENT_ID=
# PDF_SERVICES_CLIENT_SECRET=
# LLAMA_CLOUD_API_KEY=
