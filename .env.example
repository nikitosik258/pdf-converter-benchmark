# Copy to .env for LOCAL development only.
# NEVER commit .env or credential JSON files.

# OCR.Space Free OCR API
OCR_SPACE_API_KEY=

# Nutrient Data Extraction API (free tier, no card required)
NUTRIENT_DWS_EXTRACTION_API_KEY=

# Mindee V2 Raw Text (OCR)
MINDEE_V2_API_KEY=
MINDEE_OCR_MODEL_ID=

# Adobe PDF Services / Extract API
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=


# LlamaParse / LlamaCloud (ACTIVE fifth cloud provider)
LLAMA_CLOUD_API_KEY=

# Azure AI Document Intelligence F0 (PRESERVED, currently inactive)
DOCUMENTINTELLIGENCE_ENDPOINT=
DOCUMENTINTELLIGENCE_API_KEY=

# Web API runtime. Provider secrets stay server-side and are never returned by
# the API. Cloud conversion remains disabled until explicitly enabled.
PDF_BENCHMARK_WEB_STORAGE_ROOT=outputs/web_runtime
PDF_BENCHMARK_WEB_MAX_UPLOAD_BYTES=104857600
PDF_BENCHMARK_WEB_MAX_PAGES=300
PDF_BENCHMARK_WEB_DOCUMENT_TTL_SECONDS=86400
PDF_BENCHMARK_WEB_CLEANUP_INTERVAL_SECONDS=900
PDF_BENCHMARK_WEB_EXECUTOR_WORKERS=2
PDF_BENCHMARK_WEB_ADAPTER_TIMEOUT_SECONDS=5400
PDF_BENCHMARK_WEB_ALLOW_CLOUD=false
PDF_BENCHMARK_WEB_HOST=127.0.0.1
PDF_BENCHMARK_WEB_PORT=8000
